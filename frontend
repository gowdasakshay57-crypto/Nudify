<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Nudify</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: 'Poppins', sans-serif;
    }

    body {
      background: #0f172a;
       color: white;
      overflow-x: hidden;
    }

    header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 20px 8%;
      background: rgba(15, 23, 42, 0.9);
      backdrop-filter: blur(10px);
      position: sticky;
      top: 0;
      z-index: 1000;
    }

    .logo {
      font-size: 28px;
      font-weight: 700;
      color: #38bdf8;
    }

    nav a {
      text-decoration: none;
      color: white;

      margin-left: 25px;
      transition: 0.3s;
      font-weight: 500;
    }

    nav a:hover {
      color: #38bdf8;
    }

    .hero {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 8%;
      background: linear-gradient(135deg, #0f172a, #1e293b);
      gap: 40px;
    }

    .hero-text {
      max-width: 600px;
    }

    .hero-text h1 {
      font-size: 64px;
      line-height: 1.2;
      margin-bottom: 20px;
    }

    .hero-text h1 span {
      color: #38bdf8;
    }

    .hero-text p {
      font-size: 18px;
      color: #cbd5e1;
      margin-bottom: 30px;
      line-height: 1.8;
    }

      .btn {
      display: inline-block;
      padding: 14px 30px;
      background: #38bdf8;
      color: #0f172a;
      border-radius: 12px;
      text-decoration: none;
      font-weight: 600;
      transition: 0.3s ease;
    }

    .btn:hover {
      transform: translateY(-5px);
      box-shadow: 0 10px 20px rgba(56, 189, 248, 0.4);
    }

    .hero-image img {
      width: 500px;
      max-width: 100%;
      animation: float 4s ease-in-out infinite;
    }
  @keyframes float {
      0%, 100% {
        transform: translateY(0px);
      }
      50% {
        transform: translateY(-15px);
      }
    }

    .features {
      padding: 100px 8%;
      background: #111827;
    }

    .section-title {
      text-align: center;
      font-size: 42px;
      margin-bottom: 60px;
      color: #38bdf8;
    }
     .feature-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 30px;
    }

    .card {
      background: #1e293b;
      padding: 35px;
      border-radius: 20px;
      transition: 0.4s;
      border: 1px solid transparent;
    }

    .card:hover {
      transform: translateY(-10px);
      border-color: #38bdf8;
      box-shadow: 0 12px 25px rgba(0,0,0,0.4);
    }

    .card h3 {
      margin-bottom: 15px;
      color: #38bdf8;
      font-size: 24px;
    }
     .card p {
      color: #cbd5e1;
      line-height: 1.7;
    }

    .lessons {
      padding: 100px 8%;
      background: #0f172a;
    }

    .lesson-container {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 30px;
      margin-top: 50px;
    }
     .lesson-box {
      background: linear-gradient(145deg, #1e293b, #0f172a);
      border-radius: 20px;
      padding: 30px;
      transition: 0.4s;
    }

    .lesson-box:hover {
      transform: scale(1.03);
    }

    .lesson-box h4 {
      font-size: 24px;
      margin-bottom: 15px;
      color: #38bdf8;
    }

    .lesson-box ul {
      list-style: none;
    }
  .lesson-box ul li {
      margin: 10px 0;
      color: #e2e8f0;
    }

    .cta {
      padding: 100px 8%;
      text-align: center;
      background: linear-gradient(135deg, #38bdf8, #2563eb);
      color: white;
    }

    .cta h2 {
      font-size: 48px;
      margin-bottom: 20px;
    }

    .cta p {
      font-size: 18px;
      margin-bottom: 30px;
    }
     .cta .btn {
      background: white;
      color: #2563eb;
    }

    footer {
      text-align: center;
      padding: 30px;
      background: #020617;
      color: #94a3b8;
    }

    @media(max-width: 900px) {
      .hero {
        flex-direction: column;
        text-align: center;
        padding-top: 80px;
      }

      .hero-text h1 {
        font-size: 46px;
      }

        nav {
        display: none;
      }
    }
  </style>
</head>
<body>

  <header>
    <div class="logo">Nudify</div>
    <nav>
      <a href="#home">Home</a>
      <a href="#features">Features</a>
      <a href="#lessons">Lessons</a>
      <a href="#contact">Contact</a>
    </nav>
  </header>
   <section class="hero" id="home">
    <div class="hero-text">
      <h1>Learn <span>Kannada</span> the Smart Way</h1>
      <p>
        Master Kannada language with interactive lessons, pronunciation guides,
        vocabulary games, and real-life conversations in a modern learning platform.
      </p>
      <a href="#lessons" class="btn">Start Learning</a>
    </div>

    <div class="hero-image">
      <img src="https://cdn-icons-png.flaticon.com/512/3135/3135755.png" alt="Learning Illustration">
    </div>
  </section>

  <section class="features" id="features">
    <h2 class="section-title">Why Choose KannadaHub?</h2>

    <div class="feature-grid">
      <div class="card">
        <h3>📚 Interactive Lessons</h3>
        <p>Step-by-step Kannada lessons designed for beginners and advanced learners.</p>
      </div>
 <div class="card">
        <h3>🎧 Audio Pronunciation</h3>
        <p>Practice Kannada pronunciation with native speaker audio examples.</p>
      </div>

      <div class="card">
        <h3>🧠 Fun Quizzes</h3>
        <p>Improve vocabulary and grammar through engaging quizzes and mini-games.</p>
      </div>

      <div class="card">
        <h3>📱 Mobile Friendly</h3>
        <p>Learn Kannada anytime and anywhere with a fully responsive design.</p>
      </div>
    </div>
  </section>

  <section class="lessons" id="lessons">
    <h2 class="section-title">Popular Learning Modules</h2>

    <div class="lesson-container">
      <div class="lesson-box">
        <h4>Kannada Basics</h4>
        <ul>
              <li>✔ Kannada Alphabets</li>
          <li>✔ Greetings & Introductions</li>
          <li>✔ Basic Vocabulary</li>
          <li>✔ Simple Sentences</li>
        </ul>
      </div>

      <div class="lesson-box">
        <h4>Daily Conversations</h4>
        <ul>
          <li>✔ Shopping Conversations</li>
          <li>✔ Travel & Directions</li>
          <li>✔ Restaurant Kannada</li>
          <li>✔ Common Expressions</li>
        </ul>
      </div>

      <div class="lesson-box">
        <h4>Advanced Kannada</h4>
        <ul>
          <li>✔ Grammar Practice</li>
          <li>✔ Reading Stories</li>
          <li>✔ Kannada Writing Skills</li>
          <li>✔ Cultural Learning</li>
            </ul>
      </div>
    </div>
  </section>

  <section class="cta" id="contact">
    <h2>Start Your Kannada Journey Today!</h2>
    <p>Join thousands of learners and become fluent in Kannada with interactive modern lessons.</p>
    <a href="#home" class="btn">Join Now</a>
  </section>

  <footer>
    <p>© 2026 KannadaHub | Designed with ❤️ for Kannada Learners</p>
  </footer>

</body>
</html>

